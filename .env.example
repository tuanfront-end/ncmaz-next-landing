# The public origin this site is served from. Read at build time and written
# into the canonical tag, the Open Graph URLs, sitemap.xml and robots.txt, so
# set it before running `next build` for production.
#
# On Vercel this is optional: VERCEL_PROJECT_PRODUCTION_URL is used when it is
# not set. Anywhere else, leaving it unset makes the build fall back to
# http://localhost:3000 and print a warning.
NEXT_PUBLIC_SITE_URL=https://example.com
